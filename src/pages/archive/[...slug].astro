---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { archivePath } from '../../lib/paths';
import { getArchive } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getArchive();
  return posts.map((post, i) => ({
    params: { slug: archivePath(post.entry.id) },
    props: { post: post.entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Post {...post.data} archived newer={newer} older={older}>
  <Content />
</Post>
